{
  "compilerOptions": {
    "module": "ESNext", // Oder das Modulformat deiner Wahl
    "target": "ESNext",
    "skipLibCheck": true, // Typenkonflikte in node_modules ignorieren
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}